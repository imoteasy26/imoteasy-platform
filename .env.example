# Public Supabase project URL (required by the app)
NEXT_PUBLIC_SUPABASE_URL=

# Preferred browser-safe Supabase key. Use the legacy anon key only if this key is unavailable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional in v0; v0 injects the preview redirect URL. Local fallback is /auth/callback on the current origin.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
